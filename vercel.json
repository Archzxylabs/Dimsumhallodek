{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/archava/:path*",
      "destination": "https://minsum-api-production.up.railway.app/api/archava/:path*"
    }
  ]
}
